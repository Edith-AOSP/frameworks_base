<!-- Edith-only resources for the expanded lock screen media player. Kept out of the stock res/
     values files so an upstream merge does not have to step around them. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Edith media player context header: shows the app and the output device, e.g. "Spotify on This phone" [CHAR_LIMIT=NONE] -->
    <string name="edith_media_context_header"><xliff:g id="app" example="Spotify">%1$s</xliff:g> on <xliff:g id="device" example="This phone">%2$s</xliff:g></string>
    <!-- Edith media player context header: the word joining the app and the output device [CHAR_LIMIT=NONE] -->
    <string name="edith_media_on">on</string>
    <!-- Edith media player: timestamp shown when the media duration is unknown (e.g. a livestream) [CHAR_LIMIT=5] -->
    <string name="edith_media_time_unknown" translatable="false">--:--</string>
    <!-- Edith media player: accessibility description for the indeterminate seek bar of a livestream [CHAR_LIMIT=NONE] -->
    <string name="edith_media_live_description">Live</string>

    <!-- Lock screen notification chip shown over the expanded media player. -->
    <plurals name="edith_lockscreen_notification_count">
        <item quantity="one">%1$d Notification</item>
        <item quantity="other">%1$d Notifications</item>
    </plurals>

    <!-- Bottom margin under the smartspace cards on the lock screen. Smaller than
         keyguard_status_view_bottom_margin so the media card sits tight under the smartspace. -->
    <dimen name="edith_smartspace_cards_bottom_margin">0dp</dimen>
    <!-- How far the smartspace cards are pulled up towards the small clock. The small clock
         reserves more height than its visible glyphs need, so without this the card floats too
         far below it. -->
    <dimen name="edith_smartspace_cards_top_overlap">38dp</dimen>
    <!-- How far the date/weather row is pulled up when it is laid out *below* the small clock. The
         row is a short, centred view, so it already carries some slack of its own and needs less
         than the cards. -->
    <dimen name="edith_smartspace_dwa_row_overlap">28dp</dimen>
    <!-- How far the smartspace cards are pulled up when the date/weather row is laid out below the
         small clock. The card view is a full-height pager with the shorter card centred inside it,
         so it carries slack above its first line that would otherwise read as a gap after the row.
         14dp only removes that pager slack; the extra 10dp also eats into the slack above the
         title inside the card, which is what actually reads as the card's top padding. -->
    <dimen name="edith_smartspace_cards_below_dwa_overlap">24dp</dimen>

    <!-- Edith expanded lock screen media player (square album art card). -->
    <dimen name="edith_media_art_side_margin">16dp</dimen>
    <dimen name="edith_media_art_corner_radius">24dp</dimen>
    <!-- Height of the collapsed album-art banner (morphs to a square when expanded). -->
    <dimen name="edith_media_art_banner_height">204dp</dimen>
    <!-- Gap between the expanded square art and the media controls below it. -->
    <dimen name="edith_media_art_controls_gap">10dp</dimen>

</resources>
