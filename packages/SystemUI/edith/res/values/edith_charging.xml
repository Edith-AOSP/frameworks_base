<!-- Edith-only resources for the lock screen charging chip. Kept out of the stock res/ values
     files so an upstream merge does not have to step around them. -->
<resources>

    <!-- The charging chip subtitle: the battery percentage and the time to full. Both values are
         already formatted (a localised percentage and an elapsed time), so this is only the
         separator between them. [CHAR_LIMIT=NONE] -->
    <string name="edith_charging_chip_subtitle" translatable="false">%1$s • %2$s</string>

</resources>
